# Voorbeeld zonder waarden. Kopieer naar .env.local (die blijft buiten git) of zet ze in Vercel.
# Deze repo is openbaar: hier staat nooit een waarde in, alleen de naam en waar hij voor dient.

# --- De site zelf -----------------------------------------------------------------------------
# Het adres waar de site staat. Bepaalt de canonical, de Open Graph-adressen en de sitemap.
NEXT_PUBLIC_SITE_URL=
# Het meet-ID van Google Analytics. Leeg = geen banner, geen statistiek, 0 regels GA in de bundel.
NEXT_PUBLIC_GA_ID=
# 1 = dit is een voorbeeldversie: noindex in de HTML en in de header.
NEXT_PUBLIC_DEMO=

# --- De ChatGPT-koppeling ---------------------------------------------------------------------
# De GitHub App "Human Margin sitebeheer": hiermee logt Els in en hiermee schrijft de koppeling.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATIE_ID=
# De privésleutel van de app, als één regel met \n tussen de regels.
GITHUB_APP_PRIVATE_KEY=

# Wie de site mag beheren: GitHub-gebruikersnamen, gescheiden door komma's.
# LEEG = NIEMAND. Dat is de standaard tot Els een GitHub-account heeft.
TOEGESTANE_GITHUB_GEBRUIKERS=

# Waarmee de tokens van de koppeling ondertekend worden. Minstens 24 tekens, willekeurig.
KOPPELING_TOKEN_GEHEIM=
# Hoe lang een token geldig blijft, in dagen. Standaard 30.
KOPPELING_TOKEN_DAGEN=

# De repo en de tak waar de koppeling naar schrijft.
KOPPELING_REPO=ElsVHST/website_humanmargin
PUBLICATIETAK=eerste-versie
# Het adres waar de gepubliceerde versie te zien is (de voorbeeldlink van die tak).
PUBLICATIE_URL=

# --- Alleen voor de controlereeks, nooit in productie -------------------------------------------
# Een vast token voor het testprogramma. Werkt alleen als NODE_ENV niet "production" is.
KOPPELING_TESTTOKEN=
# Een lokale map die de rol van GitHub speelt tijdens het testen (K0-K4).
KOPPELING_NAGEBOOTSTE_REPO=
